node_modules/
dist/
*.log

# Astro's generated types and build cache
.astro/

# staging dir for the CI link check
linkcheck/

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory is machine-local: settings in here can hold
# your course API key, and this repo goes public when you ship. Your tracked
# harness is CLAUDE.md (and any AGENTS.md), not this directory.
.claude/

# ...except the epic plans, which are process evidence rather than machine
# state. Nothing in here holds credentials: they are the week-by-week build
# contract this site was written from, and PROCESS.md cites them. Git will not
# descend into an excluded directory, so the path has to be reopened a level at
# a time before the negation below can match.
!.claude/
.claude/*
!.claude/epics/
